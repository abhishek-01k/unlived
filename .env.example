# Copy to .env.local and fill in. Never commit .env.local.

# Nebius Token Factory (all AI calls). Base URL and model IDs: Token Factory console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily (live market data, learning links)
TAVILY_API_KEY=

# Neon Postgres (Vercel Marketplace fills this in on deploy)
DATABASE_URL=

# Debug: print the redacted resume text in the server log (check no PII leaks)
LOG_REDACTED=false
# Debug: log time, tokens and finish reason for every Nemotron call
DEBUG_AI=false
